<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:GameLauncher.App.Localization"
             xmlns:vm="clr-namespace:GameLauncher.App.ViewModels"
             mc:Ignorable="d"
             x:Class="GameLauncher.App.Views.GameDetail"
             x:DataType="vm:GameDetailViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="24,20">

    <Button Grid.Row="0" Content="{loc:Tr Detail.Back}" Classes="link"
            Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />

    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" IsVisible="{Binding IsBusy}" />

    <TextBlock Grid.Row="2" Classes="error" Text="{Binding ErrorMessage}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <ScrollViewer Grid.Row="2" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="18" MaxWidth="820" HorizontalAlignment="Left">

        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Light" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Summary}" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="24">
          <StackPanel Spacing="2">
            <TextBlock Text="{loc:Tr Detail.Publisher}" Opacity="0.5" FontSize="11" />
            <TextBlock Text="{Binding PublisherName}" />
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="{loc:Tr Detail.ReleaseDate}" Opacity="0.5" FontSize="11" />
            <TextBlock Text="{Binding ReleaseDate}" />
          </StackPanel>
          <StackPanel Spacing="2" IsVisible="{Binding HasInstallableBuild}">
            <TextBlock Text="{loc:Tr Detail.DownloadSize}" Opacity="0.5" FontSize="11" />
            <TextBlock Text="{Binding DownloadSize}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="{loc:Tr Explore.AddToLibrary}" Classes="accent"
                  Command="{Binding AddToLibraryCommand}" IsVisible="{Binding !InLibrary}" />
          <Button Content="{loc:Tr Library.Remove}"
                  Command="{Binding RemoveFromLibraryCommand}" IsVisible="{Binding InLibrary}" />
          <Button Content="{loc:Tr Library.Play}" Classes="accent"
                  Command="{Binding PlayCommand}" IsVisible="{Binding CanPlay}" />
          <Button Content="{loc:Tr Library.Install}" Classes="accent"
                  Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
          <Button Content="{loc:Tr Library.Update}" Classes="accent"
                  Command="{Binding InstallCommand}" IsVisible="{Binding CanUpdate}" />
          <Button Content="{loc:Tr Detail.Verify}"
                  Command="{Binding VerifyCommand}" IsVisible="{Binding CanVerify}" />
          <Button Content="{loc:Tr Library.Uninstall}"
                  Command="{Binding UninstallCommand}" IsVisible="{Binding CanUninstall}" />
          <Button Content="{loc:Tr Detail.CancelDownload}"
                  Command="{Binding CancelInstallCommand}" IsVisible="{Binding IsWorking}" />
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding IsWorking}">
          <TextBlock Text="{Binding PhaseText}" FontSize="12" />
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}" Height="4" />
          <TextBlock Text="{Binding ProgressDetail}" Opacity="0.6" FontSize="12"
                     IsVisible="{Binding ProgressDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <TextBlock Text="{loc:Tr Detail.Running}" Opacity="0.7" FontSize="12"
                   IsVisible="{Binding IsRunning}" />

        <TextBlock Text="{Binding InstalledVersion}" Opacity="0.7" FontSize="12"
                   IsVisible="{Binding IsInstalled}" />

        <TextBlock Text="{loc:Tr Detail.Broken}" Classes="error" TextWrapping="Wrap"
                   IsVisible="{Binding IsBroken}" />

        <StackPanel Spacing="4" IsVisible="{Binding CanEditLaunchOptions}">
          <TextBlock Text="{loc:Tr Detail.LaunchOptions}" Opacity="0.5" FontSize="11" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding LaunchOptions}" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="{loc:Tr Common.Save}"
                    Command="{Binding SaveLaunchOptionsCommand}"
                    IsEnabled="{Binding LaunchOptionsChanged}" />
          </Grid>
          <TextBlock Text="{Binding LaunchOptionsHint}" Opacity="0.5" FontSize="11"
                     TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}" Opacity="0.8" TextWrapping="Wrap"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Text="{loc:Tr Detail.NoBuildForPlatform}" Opacity="0.6" TextWrapping="Wrap"
                   IsVisible="{Binding !HasInstallableBuild}" />

        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.85"
                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Text="{loc:Tr Detail.Versions}" FontSize="18" FontWeight="Light" Margin="0,10,0,0" />

        <ItemsControl ItemsSource="{Binding Versions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VersionCardViewModel">
              <Border Classes="card" Margin="0,0,0,10">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Semver}" FontWeight="SemiBold" />
                    <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="3"
                            Padding="6,1" IsVisible="{Binding ShowStage}">
                      <TextBlock Text="{Binding Stage}" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding PublishedOn}" Opacity="0.5" FontSize="12"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Opacity="0.8"
                             IsVisible="{Binding HasReleaseNotes}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

  </Grid>

</UserControl>
