<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:GameLauncher.App.Localization"
             xmlns:vm="clr-namespace:GameLauncher.App.ViewModels"
             xmlns:models="clr-namespace:GameLauncher.Core.Models;assembly=GameLauncher.Core"
             mc:Ignorable="d"
             x:Class="GameLauncher.App.Views.Library"
             x:DataType="vm:LibraryViewModel">

  <Grid RowDefinitions="Auto,*" Margin="24,20">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <TextBlock Grid.Column="0" Text="{loc:Tr Nav.Library}" FontSize="20" FontWeight="Light"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="{loc:Tr Common.Refresh}" Classes="link"
              Command="{Binding LoadCommand}" />
    </Grid>

    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" VerticalAlignment="Top"
                 IsVisible="{Binding IsBusy}" />

    <TextBlock Grid.Row="1" Classes="error" Text="{Binding ErrorMessage}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <TextBlock Grid.Row="1" Text="{loc:Tr Library.Empty}" Opacity="0.5" MaxWidth="420"
               TextWrapping="Wrap" TextAlignment="Center"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding IsEmpty}" />

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Games}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameCardViewModel">
            <Border Classes="card" Width="300" Height="185" Margin="0,0,14,14">
              <Grid RowDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Text="{Binding Summary}" Opacity="0.7" FontSize="12"
                           TextWrapping="Wrap" Margin="0,6" />
                <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11" Opacity="0.55"
                           Margin="0,0,0,6" IsVisible="{Binding HasStatus}" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                  <Button Content="{loc:Tr Library.Play}" Classes="accent"
                          IsVisible="{Binding CanPlay}"
                          Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).PlayCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="{loc:Tr Explore.Details}" Classes="link"
                          Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).OpenGameCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="{loc:Tr Library.Remove}" Classes="link"
                          Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).RemoveCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>

</UserControl>
