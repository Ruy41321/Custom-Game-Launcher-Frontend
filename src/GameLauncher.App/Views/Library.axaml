<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:GameLauncher.App.Localization"
             xmlns:vm="clr-namespace:GameLauncher.App.ViewModels"
             xmlns:models="clr-namespace:GameLauncher.Core.Models;assembly=GameLauncher.Core"
             mc:Ignorable="d"
             x:Class="GameLauncher.App.Views.Library"
             x:DataType="vm:LibraryViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="24,20">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <TextBlock Grid.Column="0" Text="{loc:Tr Nav.Library}" FontSize="20" FontWeight="Light"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="{loc:Tr Common.Refresh}" Classes="link"
              Command="{Binding LoadCommand}" />
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource SystemAccentColor}" CornerRadius="4"
            Padding="10,6" Margin="0,0,0,14" IsVisible="{Binding IsOffline}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="{loc:Tr Status.Offline}" FontSize="12"
                   TextWrapping="Wrap" VerticalAlignment="Center"
                   IsVisible="{Binding IsOfflineWithAccount}" />
        <TextBlock Grid.Column="0" Text="{loc:Tr Status.OfflineNotSignedIn}" FontSize="12"
                   TextWrapping="Wrap" VerticalAlignment="Center"
                   IsVisible="{Binding IsOfflineWithoutAccount}" />
        <Button Grid.Column="1" Content="{loc:Tr Status.Retry}" Classes="link"
                VerticalAlignment="Center" Command="{Binding RetryCommand}" />
      </Grid>
    </Border>

    <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="2" VerticalAlignment="Top"
                 IsVisible="{Binding IsBusy}" />

    <TextBlock Grid.Row="2" Classes="error" Text="{Binding ErrorMessage}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <TextBlock Grid.Row="2" Text="{loc:Tr Library.Empty}" Opacity="0.5" MaxWidth="420"
               TextWrapping="Wrap" TextAlignment="Center"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding IsEmpty}" />

    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Games}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameCardViewModel">
            <Border Classes="card" Width="300" Margin="0,0,14,14">
              <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

                <!-- Offline the install row has no cover URL to fetch, so the placeholder is
                     what a library shows on a train. The frame is also the way into the game's
                     page: the automation name is the title because the content is a picture. -->
                <Button Grid.Row="0" Classes="bare" Margin="0,0,0,8"
                        AutomationProperties.Name="{Binding Title}"
                        IsEnabled="{Binding CanOpenDetails}"
                        Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).OpenGameCommand}"
                        CommandParameter="{Binding}">
                  <Border Height="150" CornerRadius="4" ClipToBounds="True"
                          Background="{DynamicResource SystemChromeMediumColor}">
                    <Panel>
                      <TextBlock Text="{Binding CoverPlaceholder}" FontSize="44" Opacity="0.25"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsVisible="{Binding !HasCover}" />
                      <Image Source="{Binding Cover}" Stretch="UniformToFill"
                             IsVisible="{Binding HasCover}" />
                    </Panel>
                  </Border>
                </Button>

                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" Text="{Binding Summary}" Opacity="0.7" FontSize="12"
                           TextWrapping="Wrap" Margin="0,6" MaxHeight="52" />
                <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="11" Opacity="0.55"
                           Margin="0,0,0,6" IsVisible="{Binding HasStatus}" />
                <!-- Where the Play button would have been, saying why it is not there —
                     the same sentence the game page shows, because it is the same rule. -->
                <TextBlock Grid.Row="4" Text="{loc:Tr Detail.UpdateBeforePlaying}" FontSize="11"
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"
                           IsVisible="{Binding MustUpdateBeforePlaying}" />

                <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
                  <Button Content="{loc:Tr Library.Play}" Classes="accent"
                          IsVisible="{Binding CanPlay}"
                          Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).PlayCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="{loc:Tr Explore.Details}" Classes="link"
                          IsVisible="{Binding CanOpenDetails}"
                          Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).OpenGameCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="{loc:Tr Library.Remove}" Classes="link"
                          IsVisible="{Binding CanRemove}"
                          Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).RemoveCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>

</UserControl>
