<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:GameLauncher.App.Localization"
        xmlns:vm="clr-namespace:GameLauncher.App.ViewModels"
        xmlns:core="clr-namespace:GameLauncher.Core.Localization;assembly=GameLauncher.Core"
        mc:Ignorable="d"
        x:Class="GameLauncher.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding AppName}"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Top bar: navigation, the account and the language picker. -->
    <Border Grid.Row="0" Padding="20,14" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <Image Source="{Binding Logo}" Height="24" VerticalAlignment="Center"
                 IsVisible="{Binding Logo, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding AppName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="{loc:Tr Nav.Library}" Command="{Binding ShowLibraryCommand}"
                  Classes="link" IsVisible="{Binding CanNavigate}" />
          <Button Content="{loc:Tr Nav.Explore}" Command="{Binding ShowExploreCommand}"
                  Classes="link" IsVisible="{Binding CanNavigate}" />
          <Button Content="{loc:Tr Nav.Developer}" Command="{Binding ShowDeveloperCommand}"
                  Classes="link" IsVisible="{Binding CanPublish}" />
          <Button Content="{loc:Tr Nav.Settings}" Command="{Binding ShowSettingsCommand}"
                  Classes="link" IsVisible="{Binding CanNavigate}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding AccountName}" VerticalAlignment="Center" Opacity="0.8"
                     IsVisible="{Binding IsSignedIn}" />
          <Button Content="{loc:Tr Auth.SignOut}" Command="{Binding SignOutCommand}"
                  Classes="link" IsVisible="{Binding IsSignedIn}" />

          <!-- The only way out of an offline visit: there is no session to sign out of. -->
          <Button Content="{loc:Tr Auth.SignIn}" Command="{Binding ShowLoginCommand}"
                  Classes="link" IsVisible="{Binding IsOfflineGuest}" />

          <TextBlock Text="{loc:Tr Common.Language}" VerticalAlignment="Center" Opacity="0.7" />
          <ComboBox ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding SelectedLanguage}"
                    MinWidth="130">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="core:LanguageOption">
                <TextBlock Text="{Binding NativeName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

      </Grid>
    </Border>

    <!-- A newer launcher, announced and never applied on its own: a swap needs this process to
         exit, so a silent update is an application closing under somebody's hands. -->
    <Border Grid.Row="1" Padding="20,10" IsVisible="{Binding UpdateAvailable}"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto">

        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding UpdateHeadline}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding UpdateNotes}" Opacity="0.75" TextWrapping="Wrap"
                     IsVisible="{Binding UpdateNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding UpdateStatus}" Opacity="0.75" TextWrapping="Wrap"
                     IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <Button Grid.Column="1" Content="{loc:Tr Update.Download}" Margin="12,0,0,0"
                Command="{Binding DownloadUpdateCommand}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="{loc:Tr Update.Dismiss}" Margin="12,0,0,0"
                Command="{Binding DismissUpdateCommand}" Classes="link" VerticalAlignment="Center" />

      </Grid>
    </Border>

    <!-- The ViewLocator turns whichever view model is current into its view. -->
    <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />

    <Border Grid.Row="3" Padding="20,10" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <TextBlock Text="{Binding WelcomeMessage}" FontSize="12" Opacity="0.6" />
    </Border>

  </Grid>

</Window>
