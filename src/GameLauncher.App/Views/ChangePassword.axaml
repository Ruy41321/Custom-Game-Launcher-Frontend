<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:GameLauncher.App.Localization"
             xmlns:vm="clr-namespace:GameLauncher.App.ViewModels"
             mc:Ignorable="d"
             x:Class="GameLauncher.App.Views.ChangePassword"
             x:DataType="vm:ChangePasswordViewModel">

  <ScrollViewer>
    <StackPanel Spacing="16" Margin="24,20" MaxWidth="420" HorizontalAlignment="Center"
                VerticalAlignment="Center">

      <TextBlock Text="{loc:Tr Account.ChangePassword}" FontSize="20" FontWeight="Light" />

      <!-- Only one of the two sentences is ever on screen: the forced one explains why nothing
           else is reachable, and the ordinary one has nothing to explain. -->
      <TextBlock Text="{loc:Tr Account.PasswordChangeRequired}" TextWrapping="Wrap"
                 Opacity="0.8" IsVisible="{Binding IsForced}" />

      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Tr Account.CurrentPassword}" Opacity="0.7" FontSize="12" />
        <TextBox Text="{Binding CurrentPassword}" PasswordChar="•"
                 RevealPassword="{Binding ShowPasswords}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Tr Account.NewPassword}" Opacity="0.7" FontSize="12" />
        <TextBox Text="{Binding NewPassword}" PasswordChar="•"
                 RevealPassword="{Binding ShowPasswords}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Tr Account.ConfirmPassword}" Opacity="0.7" FontSize="12" />
        <TextBox Text="{Binding ConfirmPassword}" PasswordChar="•"
                 RevealPassword="{Binding ShowPasswords}" />
        <CheckBox Content="{loc:Tr Auth.ShowPassword}" IsChecked="{Binding ShowPasswords}"
                  FontSize="12" />
      </StackPanel>

      <TextBlock Classes="error" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{loc:Tr Account.SavePassword}" Classes="accent"
                Command="{Binding SubmitCommand}" />
        <Button Content="{loc:Tr Common.Cancel}" Command="{Binding CancelCommand}"
                IsVisible="{Binding CanCancel}" />
      </StackPanel>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
