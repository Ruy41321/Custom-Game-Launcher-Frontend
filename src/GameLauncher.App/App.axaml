<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameLauncher.App"
             x:Class="GameLauncher.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />

    <!-- A button that reads as a piece of text: used for navigation and for the inline
         actions on a card, where a full button would dominate what it sits next to. -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- The theme paints a disabled button's background regardless of the setter above, which
         turns a link waiting on an empty field into a grey box that reads as broken. It stays
         a piece of text, dimmed. -->
    <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Cards: one game in Explore or the library, one version on the detail page. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#FF6B6B" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Application.Styles>

</Application>
